{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "client/dist",
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/api/og",
      "destination": "/og-image.png"
    },
    {
      "source": "/api/twitter-image",
      "destination": "/twitter-image.png"
    }
  ]
}
